{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/dev/rust-check-hook.sh\"",
            "timeout": 180,
            "statusMessage": "cargo fmt + clippy"
          }
        ]
      }
    ]
  }
}
